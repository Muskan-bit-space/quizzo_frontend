# Vite dev/preview proxy destination for /api and /socket.io (with WebSockets).
VITE_BACKEND_URL=http://127.0.0.1:4444
# Public backend origin for REST and Socket.IO; leave empty for same-origin production.
# Vercel builds use .env.vercel. Hosting environment values take precedence.
VITE_API_URL=
# Normal development and production use the real backend.
# npm run dev:demo explicitly opts into the separate .env.demo settings.
VITE_DEMO_MODE=false
